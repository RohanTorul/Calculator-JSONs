{
 "name": "Formula SAE EV Pack",
 "version": "1.0",
 "description": "Vehicle dynamics, powertrain, accumulator, HV safety, brakes, aero, cooling and scoring calculators for a Formula SAE electric car. Rule-dependent limits are editable inputs: always check the current rulebook.",
 "tools": [
  {"id":"road","name":"FSAE Veh · Road load & power","description":"Rolling, aero and grade resistance at a given speed, with wheel power and energy per km.",
   "inputs":[{"key":"m","label":"Total mass (car + driver)","unit":"kg","kind":"M","default":300},{"key":"v","label":"Speed","unit":"m/s","kind":"v","default":20},{"key":"crr","label":"Rolling resistance coeff.","unit":"","kind":"n","default":0.018},{"key":"cda","label":"Drag area CdA","unit":"m²","kind":"CdA","default":1.1},{"key":"rho","label":"Air density","unit":"kg/m³","kind":"rho","default":1.2},{"key":"grade","label":"Grade","unit":"%","kind":"n","default":0}],
   "vars":[{"name":"th","formula":"atan(grade/100)"},{"name":"fr","formula":"crr*m*9.81*cos(th)"},{"name":"fa","formula":"0.5*rho*cda*v^2"},{"name":"fg","formula":"m*9.81*sin(th)"}],
   "outputs":[{"label":"Rolling resistance","unit":"N","kind":"F","formula":"fr"},{"label":"Aero drag","unit":"N","kind":"F","formula":"fa"},{"label":"Grade force","unit":"N","kind":"F","formula":"fg"},{"label":"Total road load","unit":"N","kind":"F","formula":"fr+fa+fg"},{"label":"Power at wheels","unit":"kW","kind":"Pk","formula":"(fr+fa+fg)*v/1000"},{"label":"Energy at constant speed","unit":"Wh/km","kind":"Whkm","formula":"(fr+fa+fg)/3.6"}]},

  {"id":"wdist","name":"FSAE Veh · Weight distribution & CG position","description":"Static axle masses to front/rear weight fraction and longitudinal CG location.",
   "inputs":[{"key":"L","label":"Wheelbase","unit":"mm","kind":"L","default":1550},{"key":"mf","label":"Front axle mass (scales)","unit":"kg","kind":"M","default":140},{"key":"mr","label":"Rear axle mass (scales)","unit":"kg","kind":"M","default":160}],
   "outputs":[{"label":"Total mass","unit":"kg","kind":"M","formula":"mf+mr"},{"label":"Front weight fraction","unit":"","kind":"n","formula":"mf/(mf+mr)"},{"label":"CG distance from front axle","unit":"mm","kind":"L","formula":"L*mr/(mf+mr)"},{"label":"CG distance from rear axle","unit":"mm","kind":"L","formula":"L*mf/(mf+mr)"}]},

  {"id":"cgh","name":"FSAE Veh · CG height (tilt test)","description":"Raise the rear axle with suspension locked and read the front axle scales. Uses horizontal wheelbase L·cosθ.",
   "inputs":[{"key":"m","label":"Total mass","unit":"kg","kind":"M","default":300},{"key":"L","label":"Wheelbase","unit":"mm","kind":"L","default":1550},{"key":"H","label":"Rear axle raise height","unit":"mm","kind":"L","default":500},{"key":"mf0","label":"Front axle mass, level","unit":"kg","kind":"M","default":140},{"key":"mf1","label":"Front axle mass, raised","unit":"kg","kind":"M","default":145.6},{"key":"rw","label":"Loaded tyre radius","unit":"mm","kind":"L","default":200}],
   "vars":[{"name":"th","formula":"asin(H/L)"}],
   "outputs":[{"label":"Tilt angle","unit":"deg","kind":"deg","formula":"deg(th)"},{"label":"CG height above ground","unit":"mm","kind":"L","formula":"rw+(mf1-mf0)/m*L*cos(th)/tan(th)"}]},

  {"id":"trac","name":"FSAE Veh · Traction-limited acceleration","description":"Maximum launch acceleration from tyre friction and longitudinal weight transfer (no aero).",
   "inputs":[{"key":"drive","label":"Drive","options":[["r","Rear-wheel drive"],["a","All-wheel drive"]],"default":"r"},{"key":"mu","label":"Longitudinal friction coeff.","unit":"","kind":"n","default":1.4},{"key":"wr","label":"Static rear weight fraction","unit":"","kind":"n","default":0.53},{"key":"h","label":"CG height","unit":"mm","kind":"L","default":290},{"key":"L","label":"Wheelbase","unit":"mm","kind":"L","default":1550},{"key":"m","label":"Total mass","unit":"kg","kind":"M","default":300}],
   "vars":[{"name":"a","formula":"if(drive=='a',mu*9.81,mu*9.81*wr/(1-mu*h/L))"}],
   "outputs":[{"label":"Max acceleration","unit":"m/s²","kind":"acc","formula":"a"},{"label":"Max acceleration","unit":"g","kind":"n","formula":"a/9.81"},{"label":"Dynamic rear load fraction","unit":"","kind":"n","formula":"wr+a/9.81*h/L"},{"label":"Longitudinal weight transfer","unit":"N","kind":"F","formula":"m*a*h/L"}]},

  {"id":"acc75","name":"FSAE Veh · 75 m acceleration estimate","description":"Traction-limited launch then constant-power run. Closed-form, ignores drag and tyre slip, so expect real runs 3–6% slower.",
   "inputs":[{"key":"m","label":"Total mass","unit":"kg","kind":"M","default":300},{"key":"kr","label":"Rotating inertia factor","unit":"","kind":"n","default":1.05},{"key":"p","label":"Power at wheels","unit":"kW","kind":"Pk","default":60},{"key":"a","label":"Traction-limited acceleration","unit":"m/s²","kind":"acc","default":10},{"key":"d","label":"Distance","unit":"m","kind":"Lm","default":75}],
   "vars":[{"name":"me","formula":"m*kr"},{"name":"pw","formula":"p*1000"},{"name":"v1","formula":"pw/(me*a)"},{"name":"x1","formula":"v1^2/(2*a)"},{"name":"t1","formula":"v1/a"},{"name":"v2","formula":"(v1^3+3*pw*(d-x1)/me)^(1/3)"},{"name":"tt","formula":"if(x1>=d,sqrt(2*d/a),t1+me*(v2^2-v1^2)/(2*pw))"},{"name":"vf","formula":"if(x1>=d,sqrt(2*a*d),v2)"}],
   "outputs":[{"label":"Run time","unit":"s","kind":"s","formula":"tt"},{"label":"Final speed","unit":"m/s","kind":"v","formula":"vf"},{"label":"Final speed","unit":"km/h","kind":"kmh","formula":"vf*3.6"},{"label":"Traction-limited distance","unit":"m","kind":"Lm","formula":"min(x1,d)"},{"label":"Power limit reached at","unit":"km/h","kind":"kmh","formula":"v1*3.6"}]},

  {"id":"skid","name":"FSAE Veh · Skidpad (steady state)","description":"Maximum steady-state speed on the skidpad circle including optional downforce: m·v²/R = μ(m·g + ½ρ·ClA·v²).",
   "inputs":[{"key":"mu","label":"Lateral friction coeff.","unit":"","kind":"n","default":1.5},{"key":"m","label":"Total mass","unit":"kg","kind":"M","default":300},{"key":"R","label":"Path radius (centreline)","unit":"m","kind":"Lm","default":9.125},{"key":"cla","label":"Downforce area ClA","unit":"m²","kind":"CdA","default":0},{"key":"rho","label":"Air density","unit":"kg/m³","kind":"rho","default":1.2}],
   "vars":[{"name":"den","formula":"m/R-0.5*mu*rho*cla"},{"name":"v","formula":"sqrt(mu*m*9.81/den)"}],
   "outputs":[{"label":"Lap speed","unit":"m/s","kind":"v","formula":"v"},{"label":"Lap speed","unit":"km/h","kind":"kmh","formula":"v*3.6"},{"label":"Lateral acceleration","unit":"g","kind":"n","formula":"v^2/R/9.81"},{"label":"Lap time","unit":"s","kind":"s","formula":"2*pi*R/v"},{"label":"Downforce at this speed","unit":"N","kind":"F","formula":"0.5*rho*cla*v^2"}]},

  {"id":"llt","name":"FSAE Veh · Lateral load transfer","description":"Geometric and elastic load transfer per axle using roll-axis geometry and front roll-stiffness share. Sprung-mass simplification.",
   "inputs":[{"key":"m","label":"Total mass","unit":"kg","kind":"M","default":300},{"key":"ay","label":"Lateral acceleration","unit":"m/s²","kind":"acc","default":14.7},{"key":"h","label":"CG height","unit":"mm","kind":"L","default":290},{"key":"wf","label":"Front weight fraction","unit":"","kind":"n","default":0.47},{"key":"tf","label":"Front track","unit":"mm","kind":"L","default":1200},{"key":"tr","label":"Rear track","unit":"mm","kind":"L","default":1150},{"key":"hf","label":"Front roll centre height","unit":"mm","kind":"L","default":30},{"key":"hr","label":"Rear roll centre height","unit":"mm","kind":"L","default":50},{"key":"rsf","label":"Front share of roll stiffness","unit":"","kind":"n","default":0.52}],
   "vars":[{"name":"wr","formula":"1-wf"},{"name":"hra","formula":"wf*hf+wr*hr"},{"name":"d","formula":"(h-hra)/1000"},{"name":"ff","formula":"m*ay/(tf/1000)*(wf*hf/1000+d*rsf)"},{"name":"fr","formula":"m*ay/(tr/1000)*(wr*hr/1000+d*(1-rsf))"}],
   "outputs":[{"label":"Front load transfer (per wheel)","unit":"N","kind":"F","formula":"ff"},{"label":"Rear load transfer (per wheel)","unit":"N","kind":"F","formula":"fr"},{"label":"Front share of total transfer (LLTD)","unit":"","kind":"n","formula":"ff*tf/(ff*tf+fr*tr)"},{"label":"Roll axis height at CG","unit":"mm","kind":"L","formula":"hra"},{"label":"Roll moment arm","unit":"mm","kind":"L","formula":"h-hra"}]},

  {"id":"spring","name":"FSAE Veh · Spring, wheel rate & ride frequency","description":"Wheel rate = spring rate × MR² (MR = spring travel / wheel travel). Ride frequency ignores tyre stiffness.",
   "inputs":[{"key":"ks","label":"Spring rate","unit":"N/mm","kind":"ks","default":35},{"key":"mr","label":"Motion ratio (spring/wheel)","unit":"","kind":"n","default":1},{"key":"mc","label":"Sprung corner mass","unit":"kg","kind":"M","default":60},{"key":"t","label":"Track","unit":"mm","kind":"L","default":1200},{"key":"arb","label":"Anti-roll bar roll rate (axle)","unit":"N·m/deg","kind":"Kphi","default":0}],
   "vars":[{"name":"kw","formula":"ks*mr^2"},{"name":"kp","formula":"0.5*kw*1000*(t/1000)^2*pi/180"}],
   "outputs":[{"label":"Wheel rate","unit":"N/mm","kind":"ks","formula":"kw"},{"label":"Ride frequency","unit":"Hz","kind":"Hz","formula":"sqrt(kw*1000/mc)/(2*pi)"},{"label":"Roll rate from springs (axle)","unit":"N·m/deg","kind":"Kphi","formula":"kp"},{"label":"Total axle roll rate","unit":"N·m/deg","kind":"Kphi","formula":"kp+arb"},{"label":"Critical damping at wheel","unit":"N·s/m","kind":"cdamp","formula":"2*sqrt(kw*1000*mc)"}]},

  {"id":"damp","name":"FSAE Veh · Damper sizing","description":"Damping from a target damping ratio. Wheel damping = shock damping × MR².",
   "inputs":[{"key":"kw","label":"Wheel rate","unit":"N/mm","kind":"ks","default":35},{"key":"mc","label":"Sprung corner mass","unit":"kg","kind":"M","default":60},{"key":"zeta","label":"Target damping ratio ζ","unit":"","kind":"n","default":0.65},{"key":"mr","label":"Damper motion ratio (damper/wheel)","unit":"","kind":"n","default":1}],
   "vars":[{"name":"cc","formula":"2*sqrt(kw*1000*mc)"},{"name":"c","formula":"zeta*cc"}],
   "outputs":[{"label":"Natural frequency","unit":"Hz","kind":"Hz","formula":"sqrt(kw*1000/mc)/(2*pi)"},{"label":"Critical damping at wheel","unit":"N·s/m","kind":"cdamp","formula":"cc"},{"label":"Required damping at wheel","unit":"N·s/m","kind":"cdamp","formula":"c"},{"label":"Required damper rate","unit":"N·s/m","kind":"cdamp","formula":"c/mr^2"},{"label":"Damped frequency","unit":"Hz","kind":"Hz","formula":"sqrt(kw*1000/mc)/(2*pi)*sqrt(1-zeta^2)"}]},

  {"id":"roll","name":"FSAE Veh · Roll gradient","description":"Roll gradient from axle roll rates, including the gravity softening term m·g·d.",
   "inputs":[{"key":"kf","label":"Front axle roll rate","unit":"N·m/deg","kind":"Kphi","default":440},{"key":"kr","label":"Rear axle roll rate","unit":"N·m/deg","kind":"Kphi","default":400},{"key":"m","label":"Sprung mass","unit":"kg","kind":"M","default":260},{"key":"d","label":"Roll moment arm","unit":"mm","kind":"L","default":220},{"key":"ay","label":"Lateral acceleration","unit":"m/s²","kind":"acc","default":14.7}],
   "vars":[{"name":"mg","formula":"m*9.81*d/1000"},{"name":"keff","formula":"kf+kr-mg*pi/180"},{"name":"grad","formula":"mg/keff"}],
   "outputs":[{"label":"Roll gradient","unit":"deg/g","kind":"n","formula":"grad"},{"label":"Roll angle at this lateral accel.","unit":"deg","kind":"deg","formula":"grad*ay/9.81"},{"label":"Front share of roll stiffness","unit":"","kind":"n","formula":"kf/(kf+kr)"},{"label":"Total roll rate","unit":"N·m/deg","kind":"Kphi","formula":"kf+kr"}]},

  {"id":"under","name":"FSAE Veh · Understeer gradient (bicycle model)","description":"Steady-state handling from axle cornering stiffnesses: K = Wf/Cαf − Wr/Cαr, steer angle δ = L/R + K·ay/g.",
   "inputs":[{"key":"m","label":"Total mass","unit":"kg","kind":"M","default":300},{"key":"L","label":"Wheelbase","unit":"mm","kind":"L","default":1550},{"key":"wf","label":"Front weight fraction","unit":"","kind":"n","default":0.47},{"key":"caf","label":"Front axle cornering stiffness","unit":"N/rad","kind":"Calpha","default":65000},{"key":"car","label":"Rear axle cornering stiffness","unit":"N/rad","kind":"Calpha","default":100000},{"key":"v","label":"Speed","unit":"m/s","kind":"v","default":12},{"key":"R","label":"Corner radius","unit":"m","kind":"Lm","default":15}],
   "vars":[{"name":"k","formula":"m*9.81*wf/caf-m*9.81*(1-wf)/car"},{"name":"ay","formula":"v^2/R"},{"name":"dl","formula":"L/1000/R+k*ay/9.81"}],
   "outputs":[{"label":"Understeer gradient","unit":"deg/g","kind":"n","formula":"deg(k)"},{"label":"Road-wheel steer angle","unit":"deg","kind":"deg","formula":"deg(dl)"},{"label":"Lateral acceleration","unit":"g","kind":"n","formula":"ay/9.81"},{"label":"Characteristic speed (understeer)","unit":"km/h","kind":"kmh","formula":"if(k>0,sqrt(L/1000*9.81/k)*3.6,0)"},{"label":"Critical speed (oversteer)","unit":"km/h","kind":"kmh","formula":"if(k<0,sqrt(-L/1000*9.81/k)*3.6,0)"}]},

  {"id":"ack","name":"FSAE Veh · Ackermann & steering ratio","description":"Ideal Ackermann wheel angles for a turn radius and overall steering ratio from rack travel per revolution and steering arm length.",
   "inputs":[{"key":"L","label":"Wheelbase","unit":"mm","kind":"L","default":1550},{"key":"tf","label":"Front track","unit":"mm","kind":"L","default":1200},{"key":"R","label":"Turn radius (vehicle centreline)","unit":"m","kind":"Lm","default":9.125},{"key":"rack","label":"Rack travel per steering wheel rev","unit":"mm","kind":"L","default":70},{"key":"arm","label":"Steering arm length","unit":"mm","kind":"L","default":80}],
   "vars":[{"name":"di","formula":"deg(atan(L/1000/(R-tf/2000)))"},{"name":"dout","formula":"deg(atan(L/1000/(R+tf/2000)))"},{"name":"perrev","formula":"deg(asin(min(1,rack/arm)))"},{"name":"ratio","formula":"360/perrev"}],
   "outputs":[{"label":"Inside wheel angle","unit":"deg","kind":"deg","formula":"di"},{"label":"Outside wheel angle","unit":"deg","kind":"deg","formula":"dout"},{"label":"Ackermann difference","unit":"deg","kind":"deg","formula":"di-dout"},{"label":"Centreline (bicycle) angle","unit":"deg","kind":"deg","formula":"deg(atan(L/1000/R))"},{"label":"Road-wheel angle per steering rev","unit":"deg","kind":"deg","formula":"perrev"},{"label":"Overall steering ratio","unit":"","kind":"n","formula":"ratio"},{"label":"Steering wheel angle for this turn","unit":"deg","kind":"deg","formula":"(di+dout)/2*ratio"}]},

  {"id":"gear","name":"FSAE Veh · Gearing & top speed","description":"Overall ratio from two stages, top speed at maximum motor rpm and the ratio needed for a target speed.",
   "inputs":[{"key":"nmax","label":"Max motor speed","unit":"rpm","kind":"N","default":6000},{"key":"rw","label":"Loaded tyre radius","unit":"mm","kind":"L","default":200},{"key":"r1","label":"Stage 1 ratio (e.g. planetary)","unit":"","kind":"n","default":1},{"key":"r2","label":"Stage 2 ratio (e.g. chain)","unit":"","kind":"n","default":4.5},{"key":"vt","label":"Target top speed","unit":"m/s","kind":"v","default":30}],
   "vars":[{"name":"r","formula":"r1*r2"},{"name":"w","formula":"nmax*2*pi/60"}],
   "outputs":[{"label":"Overall ratio","unit":"","kind":"n","formula":"r"},{"label":"Top speed","unit":"m/s","kind":"v","formula":"w/r*rw/1000"},{"label":"Top speed","unit":"km/h","kind":"kmh","formula":"w/r*rw/1000*3.6"},{"label":"Speed per 1000 motor rpm","unit":"km/h","kind":"kmh","formula":"w/r*rw/1000*3.6*1000/nmax"},{"label":"Ratio needed for target speed","unit":"","kind":"n","formula":"w*rw/1000/vt"}]},

  {"id":"wtq","name":"FSAE Veh · Motor to wheel torque & speed","description":"Wheel torque, tractive force, road speed and wheel power from motor torque and speed through the drivetrain.",
   "inputs":[{"key":"tm","label":"Motor torque","unit":"N·m","kind":"T","default":150},{"key":"nm","label":"Motor speed","unit":"rpm","kind":"N","default":3000},{"key":"r","label":"Overall ratio","unit":"","kind":"n","default":4.5},{"key":"eta","label":"Drivetrain efficiency","unit":"","kind":"n","default":0.95},{"key":"rw","label":"Loaded tyre radius","unit":"mm","kind":"L","default":200}],
   "vars":[{"name":"tw","formula":"tm*r*eta"},{"name":"ww","formula":"nm*2*pi/60/r"}],
   "outputs":[{"label":"Total wheel torque","unit":"N·m","kind":"T","formula":"tw"},{"label":"Tractive force","unit":"N","kind":"F","formula":"tw/(rw/1000)"},{"label":"Road speed","unit":"m/s","kind":"v","formula":"ww*rw/1000"},{"label":"Road speed","unit":"km/h","kind":"kmh","formula":"ww*rw/1000*3.6"},{"label":"Power at wheels","unit":"kW","kind":"Pk","formula":"tw*ww/1000"}]},

  {"id":"netacc","name":"FSAE Veh · Net acceleration","description":"Acceleration from tractive force and road load, limited by tyre traction.",
   "inputs":[{"key":"ft","label":"Tractive force","unit":"N","kind":"F","default":2000},{"key":"fl","label":"Road load","unit":"N","kind":"F","default":200},{"key":"m","label":"Total mass","unit":"kg","kind":"M","default":300},{"key":"kr","label":"Rotating inertia factor","unit":"","kind":"n","default":1.05},{"key":"amax","label":"Traction limit","unit":"m/s²","kind":"acc","default":13}],
   "vars":[{"name":"a","formula":"(ft-fl)/(m*kr)"}],
   "outputs":[{"label":"Power-limited acceleration","unit":"m/s²","kind":"acc","formula":"a"},{"label":"Usable acceleration","unit":"m/s²","kind":"acc","formula":"min(a,amax)"},{"label":"Usable acceleration","unit":"g","kind":"n","formula":"min(a,amax)/9.81"},{"label":"Traction-limited? (1 = yes)","unit":"","kind":"n","formula":"if(a>amax,1,0)"}]},

  {"id":"tv","name":"FSAE Veh · Torque vectoring yaw moment","description":"Yaw moment from left/right motor torque difference on a dual-motor rear axle.",
   "inputs":[{"key":"tl","label":"Left motor torque","unit":"N·m","kind":"T","default":100},{"key":"tr","label":"Right motor torque","unit":"N·m","kind":"T","default":150},{"key":"r","label":"Ratio motor to wheel","unit":"","kind":"n","default":4.5},{"key":"eta","label":"Drivetrain efficiency","unit":"","kind":"n","default":0.95},{"key":"rw","label":"Loaded tyre radius","unit":"mm","kind":"L","default":200},{"key":"t","label":"Rear track","unit":"mm","kind":"L","default":1150},{"key":"iz","label":"Yaw inertia","unit":"kg·m²","kind":"Iz","default":105}],
   "vars":[{"name":"fl","formula":"tl*r*eta/(rw/1000)"},{"name":"fr","formula":"tr*r*eta/(rw/1000)"},{"name":"mz","formula":"(fr-fl)*t/2000"}],
   "outputs":[{"label":"Left wheel force","unit":"N","kind":"F","formula":"fl"},{"label":"Right wheel force","unit":"N","kind":"F","formula":"fr"},{"label":"Total tractive force","unit":"N","kind":"F","formula":"fl+fr"},{"label":"Yaw moment","unit":"N·m","kind":"T","formula":"mz"},{"label":"Yaw acceleration","unit":"rad/s²","kind":"n","formula":"mz/iz"}]},

  {"id":"shaft","name":"FSAE Veh · Halfshaft sizing","description":"Minimum solid shaft diameter from peak torque using shear yield 0.577·Sy, plus factor of safety for a chosen diameter.",
   "inputs":[{"key":"tw","label":"Peak wheel-axle torque (total)","unit":"N·m","kind":"T","default":640},{"key":"nsh","label":"Shafts sharing torque","unit":"","kind":"n","default":2},{"key":"sy","label":"Yield strength Sy","unit":"MPa","kind":"S","default":655},{"key":"sf","label":"Design safety factor","unit":"","kind":"n","default":2},{"key":"d","label":"Chosen shaft diameter","unit":"mm","kind":"L","default":22}],
   "vars":[{"name":"ts","formula":"tw/nsh*1000"},{"name":"tau","formula":"16*ts/(pi*d^3)"}],
   "outputs":[{"label":"Torque per shaft","unit":"N·m","kind":"T","formula":"ts/1000"},{"label":"Minimum diameter","unit":"mm","kind":"L","formula":"(16*ts*sf/(pi*0.577*sy))^(1/3)"},{"label":"Shear stress at chosen diameter","unit":"MPa","kind":"S","formula":"tau"},{"label":"Factor of safety at chosen diameter","unit":"","kind":"n","formula":"0.577*sy/tau"}]},

  {"id":"frame","name":"FSAE Veh · Frame torsional stiffness","description":"Torsional stiffness from a two-point load test with the opposite axle fixed.",
   "inputs":[{"key":"f","label":"Applied